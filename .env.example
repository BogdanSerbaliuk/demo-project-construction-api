# Committed on purpose: lists what the server needs, with no real values.
# Locally: copy to .env and fill in. On Render: set these in the dashboard.

# Neon connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# The frontend allowed to call this API — no trailing slash
ORIGIN=http://localhost:5173

# "production" on Render: turns on Secure + SameSite=None cookies
NODE_ENV=development
